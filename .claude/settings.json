{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "uv run --no-project python \"$CLAUDE_PROJECT_DIR\"/.claude/hooks/session_start.py",
            "timeout": 30
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "C:/Users/Felipe/AppData/Roaming/uv/tools/bmad-loop/Scripts/bmad-loop.exe relay SessionStart"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash|Edit|Write|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "uv run --no-project python \"$CLAUDE_PROJECT_DIR\"/.claude/hooks/guard.py",
            "timeout": 150
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "uv run --no-project python \"$CLAUDE_PROJECT_DIR\"/.claude/hooks/auto_push.py",
            "timeout": 180
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "C:/Users/Felipe/AppData/Roaming/uv/tools/bmad-loop/Scripts/bmad-loop.exe relay Stop"
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "C:/Users/Felipe/AppData/Roaming/uv/tools/bmad-loop/Scripts/bmad-loop.exe relay SessionEnd"
          }
        ]
      }
    ],
    "PreCompact": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "C:/Users/Felipe/AppData/Roaming/uv/tools/bmad-loop/Scripts/bmad-loop.exe relay PreCompact"
          }
        ]
      }
    ],
    "Notification": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "C:/Users/Felipe/AppData/Roaming/uv/tools/bmad-loop/Scripts/bmad-loop.exe relay Notification"
          }
        ]
      }
    ]
  }
}
